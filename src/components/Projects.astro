---
import Section from './Section.astro';

const projects = [
  {
    name: 'Kanban Gamify',
    featured: true,
    blurb: 'Manifest V3 Chrome extension that gamifies GitHub Projects boards with confetti, Web Audio chimes, and a draggable streak/today/all-time HUD on task completion. Vanilla JS, modular plugin architecture, no build step.',
    repo: 'https://github.com/Neveon/kanban-gamify',
    screenshot: '/kanban-gamify.svg',
  },
  {
    name: 'Claude Gamify',
    featured: true,
    blurb: 'Electron overlay that gamifies Claude Code and the Claude desktop app with sound, confetti, fireworks, XP, levels, and streaks when a session completes or you commit/push. Built on Claude Code hooks.',
    repo: 'https://github.com/Neveon/claude-gamify',
    screenshot: '/claude-gamify.svg',
  },
];
---

<Section id="projects" title="Recent Projects">
  <div class="flex flex-col gap-5">
    {projects.map((p) => (
      <article class="flex flex-col rounded-lg border border-slate-200 bg-slate-50/50 p-6 transition hover:border-[var(--accent)] dark:border-stone-800 dark:bg-stone-900/50">
        {p.featured && p.screenshot && (
          <div class="mb-5 overflow-hidden rounded-md border border-slate-200 bg-white dark:border-stone-800 dark:bg-stone-950">
            <img
              src={p.screenshot}
              alt={`${p.name} screenshot`}
              class="aspect-[16/8] w-full object-cover object-top"
              loading="lazy"
            />
          </div>
        )}
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-stone-100">{p.name}</h3>
          {p.note && (
            <span class="text-xs text-slate-500 dark:text-stone-500">{p.note}</span>
          )}
        </div>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-stone-400">
          {p.blurb}
        </p>
        {(p.live || p.repo) && (
          <div class="mt-4 flex gap-4 text-sm">
            {p.live && (
              <a href={p.live} target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--accent)] hover:text-[var(--accent-strong)]">
                Live →
              </a>
            )}
            {p.repo && (
              <a href={p.repo} target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--accent)] hover:text-[var(--accent-strong)]">
                GitHub →
              </a>
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</Section>
